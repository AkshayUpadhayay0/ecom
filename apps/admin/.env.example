# Copy to `.env.local` (git-ignored). Values are compiled into the browser bundle: never put
# secrets here.

# Base URL of the Urban Ibile API, including /api/v1. The admin origin (http://localhost:5173)
# must be listed in the API's CORS_ORIGINS. In production the admin and API must share a parent
# domain over HTTPS (e.g. admin.example.com + api.example.com) for the refresh cookie to work.
VITE_API_BASE_URL=http://localhost:4000/api/v1
