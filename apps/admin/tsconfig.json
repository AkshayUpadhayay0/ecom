{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser app bundled by Vite (overrides the Node settings of the base config).
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    // Radix/shadcn prop types conflict with this flag; `strict` stays on.
    "exactOptionalPropertyTypes": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
