# Copy to `.env` in the repo root and fill in real values. `.env` is git-ignored: never commit it.

# --- Runtime ---
NODE_ENV=development
PORT=4000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Number of reverse-proxy hops to trust for client IPs (0 = none, local dev).
TRUST_PROXY=0

# --- Database (PostgreSQL 16) ---
# Main development database. Used by the API and by kysely-codegen.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecom
# Integration tests ONLY. Must point at a separate database (never `ecom`).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecom_test
DB_POOL_MAX=10
# Timeout for the health-check database ping.
DB_HEALTH_TIMEOUT_MS=2000

# --- HTTP security ---
# Comma-separated list of allowed browser origins (admin panel, website).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Global rate limit per IP for /api/v1 (window in ms, max requests per window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# --- Auth ---
# REQUIRED. Random strings of at least 32 characters; the two must differ. The API refuses to
# start otherwise. Generate one (any shell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Customer access tokens (website + mobile app).
# JWT_REFRESH_SECRET=f813e67e3a70545b440b662b7a1d8127f3dd20468d665a14380e39fefdcd79251bd7f8dc6902ea410d029a339789dff8
JWT_ACCESS_SECRET=c88d834029ce37c6f9005de7d08c34649db1ba3956d6f28436de015d6ea39ee618beab0fd192dab134811907d998ebc5
# Admin access tokens (separate secret AND audience: tokens cannot cross over).
JWT_ADMIN_ACCESS_SECRET=e3194f9e6e1d6c484c6bd9a36f7fd662934873a3dcea04343075f3df4d4f2629a2c18e39440cbb5219f7b3089ff2ef5f
JWT_ISSUER=urban-ibile-api
ACCESS_TOKEN_TTL_SECONDS=900
CUSTOMER_REFRESH_TTL_DAYS=30
ADMIN_REFRESH_TTL_HOURS=12
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=10
# Lockout: this many wrong passwords locks the account for AUTH_LOCKOUT_MINUTES.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Stricter per-IP limit for login/register/verify/reset routes (per route).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Refresh-token cookies are Secure (HTTPS only) when true; always on in production.
COOKIE_SECURE=false
# [PENDING] version label of the terms customers accept at registration.
TERMS_VERSION=draft

# --- Email ---
# Website base URL used in email links (verify email, reset password). [PENDING] production URL.
PUBLIC_WEB_URL=http://localhost:3000
# [PENDING] sender address. Emails are currently MOCK: written to the API log, not delivered.
EMAIL_FROM=Urban Ibile <no-reply@example.invalid>
EMAIL_OUTBOX_POLL_MS=5000
