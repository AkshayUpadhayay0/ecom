# Copy to `.env` in the repo root and fill in real values. `.env` is git-ignored: never commit it.

# --- Runtime ---
NODE_ENV=development
PORT=4000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Reverse-proxy hops to trust for the client IP (rate limits and account lockouts are per IP).
# 1 = the website's BFF (or a load balancer) sits in front of the API and forwards X-Forwarded-For.
# Use 1 whenever the customer website is in use; 0 only when clients call the API directly.
TRUST_PROXY=1

# --- Database (PostgreSQL 16) ---
# Main development database. Used by the API and by kysely-codegen.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecom
# Integration tests ONLY (optional). Leave empty to use DATABASE_URL with the database name changed
# to "<name>_test" (here: ecom_test). If you set it, use the SAME user and password as DATABASE_URL
# (same Postgres server); only the database name differs, and it must end in "_test" (tests refuse
# anything else, so they can never touch `ecom`). Create + migrate it with: pnpm db:test:setup
TEST_DATABASE_URL=
DB_POOL_MAX=10
# Timeout for the health-check database ping.
DB_HEALTH_TIMEOUT_MS=2000

# --- HTTP security ---
# Comma-separated list of allowed browser origins (admin panel, website).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Global rate limit per IP for /api/v1 (window in ms, max requests per window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# --- Auth ---
# REQUIRED. Random strings of at least 32 characters; the two must differ. The API refuses to
# start otherwise. NEVER put real values in this example file. Generate each one (any shell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Customer access tokens (website + mobile app).
JWT_ACCESS_SECRET=
# Admin access tokens (separate secret AND audience: tokens cannot cross over).
JWT_ADMIN_ACCESS_SECRET=
JWT_ISSUER=urban-ibile-api
ACCESS_TOKEN_TTL_SECONDS=900
CUSTOMER_REFRESH_TTL_DAYS=30
ADMIN_REFRESH_TTL_HOURS=12
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=10
# Lockout: this many wrong passwords locks the account for AUTH_LOCKOUT_MINUTES.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Stricter per-IP limit for login/register/verify/reset routes (per route).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Refresh-token cookies are Secure (HTTPS only) when true; always on in production.
COOKIE_SECURE=false
# [PENDING] version label of the terms customers accept at registration.
TERMS_VERSION=draft

# --- Email ---
# Website origin used in email links (/verify-email, /reset-password): must be where apps/web runs.
# [PENDING] production URL.
PUBLIC_WEB_URL=http://localhost:3000
# [PENDING] sender address. The email provider is a Pending Client Decision.
EMAIL_FROM=Urban Ibile <no-reply@example.invalid>
# log = MOCK: emails are written to the worker log and EMAIL_LOG_DIR, nothing is delivered.
# Refused in production (a real provider is required there).
EMAIL_PROVIDER=log
# EMAIL_LOG_DIR=            # default: <repo>/.mock-emails
# Emails are sent by the background worker (pnpm worker), not by the API process.
EMAIL_OUTBOX_POLL_MS=5000
EMAIL_OUTBOX_BATCH=20

# --- Hidden pages / serial access ---
# REQUIRED. Key for HMAC-SHA256 of serial numbers (only hashes are stored). 32+ random chars,
# different from the JWT secrets. Keep it stable: changing it invalidates every imported serial.
SERIAL_HMAC_SECRET=
# Unlock attempts per window; only FAILED attempts count.
HIDDEN_UNLOCK_WINDOW_MS=900000
HIDDEN_UNLOCK_MAX_PER_IP=10
HIDDEN_UNLOCK_MAX_PER_PAGE=50
# Pause (ms) before answering a failed unlock.
HIDDEN_UNLOCK_FAILURE_DELAY_MS=400

# --- Public storefront API (Phase 4) ---
# Per-IP limit for /catalog and /site (stricter than the global limit used by admin routes).
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
# Cache-Control max-age (seconds) for catalog/site responses; ETags give cheap 304s.
PUBLIC_CACHE_MAX_AGE_SECONDS=60

# --- Media (Phase 3) ---
# local = files in .media-local/ served by this API with signed URLs (dev/test, no keys needed).
# r2    = Cloudflare R2 (required in production). Keys are secrets: never commit them.
MEDIA_STORAGE_DRIVER=local
# MEDIA_LOCAL_DIR=          # default: <repo>/.media-local
# MEDIA_LOCAL_SECRET=       # 32+ chars; random per process when unset
API_PUBLIC_URL=http://localhost:4000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# Public (CDN) base URL of the public bucket, e.g. https://media.example.com
R2_PUBLIC_BASE_URL=
# Media worker (pnpm worker:media). On Windows you can give full paths, e.g.
# FFMPEG_PATH=C:fmpeginfmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_X264_PRESET=veryfast
FFMPEG_X264_CRF=23
# Fallback poll only: the worker wakes immediately (Postgres LISTEN/NOTIFY) when an upload is completed.
MEDIA_WORKER_POLL_MS=2000
# How many FFmpeg encodes of one video run at once (1 to 4). 1 is fastest on most machines (x264 uses
# every core); it is also the limit that protects the machine. Uploads still overlap the next encode.
MEDIA_TRANSCODE_PARALLELISM=1
# Website freshness (optional, set BOTH or neither). After an admin change, or when a video/image becomes
# ready, the API and worker POST here so the website drops its cached public data at once instead of
# after its cache time. WEB_REVALIDATE_URL is the website's /api/revalidate (server to server only);
# WEB_REVALIDATE_SECRET must equal the website's REVALIDATE_SECRET (same value in both apps, 32+ chars).
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# WEB_REVALIDATE_SECRET=
# MEDIA_TEMP_DIR=           # default: OS temp folder
MEDIA_UPLOAD_RATE_LIMIT_WINDOW_MS=900000
MEDIA_UPLOAD_RATE_LIMIT_MAX=60

# --- Blueprint / Body Scan (Phase 5a) ---
# none = Body Scan unavailable; mock = MOCK adapter with fixed sample results (dev/test only,
# refused in production). The real provider is a team decision.
BODY_SCAN_PROVIDER=mock
# BODY_SCAN_MOCK_WEBHOOK_SECRET=   # 32+ chars; random per process when unset

# --- Cart + checkout (Phase 5b) ---
CART_RATE_LIMIT_WINDOW_MS=60000
CART_RATE_LIMIT_MAX=120
CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
CHECKOUT_RATE_LIMIT_MAX=20
# Expired reservations released per worker sweep (pnpm worker).
RESERVATION_SWEEP_BATCH=200

# --- Payments (Phase 6) ---
# mock     = MOCK provider with a dev checkout page on this API (no money; refused in production).
# paystack = real Paystack (test keys sk_test_... in dev). Required in production.
PAYMENT_PROVIDER=mock
# SECRET. Paystack secret key; also verifies webhook signatures. Never commit a real key.
# Required in production or when PAYMENT_PROVIDER=paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# PLACEHOLDER: the storefront does not exist yet. Must be set to the real storefront page that
# receives the customer after paying (it then calls GET /api/v1/payments/verify).
PAYSTACK_CALLBACK_URL=http://localhost:3000/PLACEHOLDER-checkout/return
PAYSTACK_TIMEOUT_MS=10000
PAYSTACK_VERIFY_RETRIES=2
# MOCK_PAYMENTS_DIR=        # default: <repo>/.mock-payments (MOCK provider state)
PAYMENTS_RATE_LIMIT_WINDOW_MS=60000
PAYMENTS_RATE_LIMIT_MAX=30
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=300

# --- Admin (Phase 7a) ---
# Shared per-IP limit for every admin write (POST/PATCH/PUT/DELETE under /api/v1/admin).
ADMIN_WRITE_RATE_LIMIT_WINDOW_MS=60000
ADMIN_WRITE_RATE_LIMIT_MAX=120
# Seconds the dashboard numbers (GET /admin/stats/overview) are cached in memory.
ADMIN_STATS_CACHE_SECONDS=30

# --- Returns (Phase 7b) ---
# Customer evidence uploads (create + complete) per IP.
CUSTOMER_UPLOAD_RATE_LIMIT_WINDOW_MS=900000
CUSTOMER_UPLOAD_RATE_LIMIT_MAX=30
# Return create / reply / cancel per IP.
RETURNS_RATE_LIMIT_WINDOW_MS=900000
RETURNS_RATE_LIMIT_MAX=30

# --- Customer website (apps/web) ---
# Copy these to apps/web/.env.local. The API must list the web origin in CORS_ORIGINS (above).
# API_BASE_URL=http://localhost:4000              # server-side calls to the API (may be an internal address)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000  # API origin the browser may load media from (customer calls go through /api/bff)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000      # the website's own origin: canonical URLs, sitemap, CSRF origin check
# Public media base URL: the SAME value the API uses as R2_PUBLIC_BASE_URL (objects are <base>/media/...).
# Only this host and its /media/ path are accepted for pictures (images.remotePatterns, CSP, MediaImage).
# Development: the bucket's r2.dev URL (rate-limited, dev only). Production: a custom domain behind the CDN.
# Not needed when MEDIA_STORAGE_DRIVER=local: the API origin (NEXT_PUBLIC_API_BASE_URL) is always allowed
# for its /api/v1/media-local/public/media/ path. Restart the web app after changing it (build-time value).
# NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev
# NEXT_PUBLIC_MEDIA_ORIGINS=                      # optional extra media base URLs, comma separated
# NEXT_ALLOW_LOCAL_MEDIA=false                    # true only when media is served from localhost outside dev (e2e)
# WEB_COOKIE_SECURE=                              # force Secure cookies on/off (default: on when NEXT_PUBLIC_SITE_URL is https)
# NEXT_PUBLIC_ENABLE_PIDGIN=false                 # English/Pidgin switcher; keep off until the client's Pidgin copy exists
# NEXT_PUBLIC_ENABLE_BODY_SCAN=false              # Body Scan entry in Find My Size (MOCK provider only; also needs BODY_SCAN_PROVIDER=mock)
#
# DEPLOYMENT NOTE: run a SINGLE web instance until the refresh-token rotation grace window exists in
# the API. The API revokes a session when a rotated refresh token is presented twice; the website
# serialises refreshes inside one process only, so two instances could log shoppers out.
# See docs/web-auth-bff.md and "Known launch blockers" in CLAUDE.md.