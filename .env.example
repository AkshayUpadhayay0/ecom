# Copy to `.env` in the repo root and fill in real values. `.env` is git-ignored: never commit it.

# --- Runtime ---
NODE_ENV=development
PORT=4000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Number of reverse-proxy hops to trust for client IPs (0 = none, local dev).
TRUST_PROXY=0

# --- Database (PostgreSQL 16) ---
# Main development database. Used by the API and by kysely-codegen.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecom
# Integration tests ONLY. Must point at a separate database (never `ecom`).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecom_test
DB_POOL_MAX=10
# Timeout for the health-check database ping.
DB_HEALTH_TIMEOUT_MS=2000

# --- HTTP security ---
# Comma-separated list of allowed browser origins (admin panel, website).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Global rate limit per IP for /api/v1 (window in ms, max requests per window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300